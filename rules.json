    {
      "category": "redist_folder",
      "pattern": "^_?commonredist(s)?$",
      "desc": {
        "en": "Shared redistributables folder (e.g. _CommonRedist)",
        "uk": "Спільна тека редистрибутивів (наприклад _CommonRedist)"
      },
      "confidence": 90
    },
    {
